# Create EmailOctopus API key at https://emailoctopus.com/api-documentation
EMAILOCTOPUS_API_KEY=
# List ID can be found in the URL as a UUID after clicking a list on https://emailoctopus.com/lists
# or the settings page of your list https://emailoctopus.com/lists/{UUID}/settings
EMAILOCTOPUS_LIST_ID=

# Create Beehive API key at https://developers.beehiiv.com/docs/v2/bktd9a7mxo67n-create-an-api-key
BEEHIVE_API_KEY=
BEEHIVE_PUBLICATION_ID=

# Create an OpenWeather API key for the homepage Weather widget.
OPENWEATHER_API_KEY=
# Override the endpoint when the global OpenWeather API is reachable.
OPENWEATHER_BASE_URL=https://cn-api.openweathermap.org

# Chinese locations use QWeather's server-side API. Add the API Host from your QWeather console.
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# Optional server-only write boundary for /api/admin/homepage.
SUPABASE_SERVICE_ROLE_KEY=
HOMEPAGE_SETTINGS_ADMIN_TOKEN=
